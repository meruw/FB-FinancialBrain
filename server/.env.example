# Required — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Set to true during live demo if network is unreliable — all endpoints return mocks
DEMO_MODE=false

# Server port (default: 4000)
PORT=4000

# Vite dev server port — used for CORS allowlist (default: 5173)
CLIENT_PORT=5173

# AI models 
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_NARRATOR=claude-sonnet-4-6
